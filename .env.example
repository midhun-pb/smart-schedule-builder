# Smart Schedule Builder - Environment Configuration Template
PROJECT_NAME="Smart Schedule Builder"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite local by default; set PostgreSQL connection string for production)
DATABASE_URL="sqlite:///./smart_schedule.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/smart_schedule"

# Frontend API Base URL
VITE_API_BASE="http://localhost:8000/api"
